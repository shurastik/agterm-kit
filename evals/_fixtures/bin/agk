#!/bin/bash
# Stand-in agk for the skill evals: logs its argv to agk-calls.log in the
# workspace and plays the review outcomes of case $EVAL_AGK_CASE from
# .eval/outcomes/<case>/round-<k>.json, staged into the workspace by the
# scaffold from evals/_fixtures/outcomes/ (approve when absent). Plan reviews
# (--change) and diff reviews (--base) are both played; a diff run records the
# fingerprint of the workspace per round and the merge base the scope was built
# from (rounds/<k>/merge-base), which `review fresh` compares against.
# A case may hold plan and code review outcomes side by side (plan-round-<k>.json
# for a --change run, code-round-<k>.json for a diff run, round-<k>.json for both)
# and status outcomes that `review wait` plays once instead of the review
# (plan-wait-<k>.json, code-wait-<k>.json). `apply start|wait|send` play an
# applier: apply-round-<k>.json is the round's report (done by default, which
# also writes the code file widget.go), apply-wait-<k>.json a status `apply wait`
# plays once first (needs-human, cancelled).
# `autopilot on|off` logs its call and prints the inline answer; `--autopilot` on
# the two starts is accepted and logged.
# `sync` and `finish` play the worktree commands on the workspace repository
# standing on the change's branch (see scaffold-archive.sh --worktree).
set -uo pipefail
# The agent's sandbox cannot run Apple's /usr/bin/git shim (xcrun wants a cache
# file outside the sandbox); the real binary behind it works.
GIT="$(command -v git || echo git)"
if ! "$GIT" --version >/dev/null 2>&1; then
  for c in /Library/Developer/CommandLineTools/usr/bin/git /Applications/Xcode.app/Contents/Developer/usr/bin/git /opt/homebrew/bin/git /usr/local/bin/git; do
    if [ -x "$c" ]; then GIT="$c"; break; fi
  done
fi
git() { "$GIT" "$@"; }
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# Run from the main checkout of a worktree case (`agk finish`), the stand-in
# still logs and plays the outcomes of the workspace that holds the case.
ws="$(git config --get eval.workspace 2>/dev/null || true)"
if [ -n "$ws" ] && [ -d "$ws" ]; then root="$ws"; fi
# A change worktree made by `apply start` (the `worktree` marker) points eval.log at
# the main workspace: file operations stay in the directory the stand-in runs in,
# the log and the outcomes are the main workspace's.
logroot="$root"
lw="$(git config --get eval.log 2>/dev/null || true)"
if [ -n "$lw" ] && [ -d "$lw" ]; then logroot="$lw"; fi
log="$logroot/agk-calls.log"
outcomes="$logroot/.eval/outcomes/${EVAL_AGK_CASE:-none}"
companion="EVAL-COMPANION"
echo "agk $*" >> "$log"
note() { echo "  $*" >> "$log"; }
die() { echo "agk: $*" >&2; note "error: $*"; exit 1; }
need() { [ "$2" -ge 2 ] || die "flag $1 needs a value"; } # flag, args left

checksums() { # change -> sorted "sum  path" lines of the change's files
  (cd "$root" && find "openspec/changes/$1" -type f -print0 | sort -z | xargs -0 shasum 2>/dev/null)
}
run_dir() { # validate a run dir argument: a plan run (change) or a diff run (base)
  local d="$1"
  [ -n "$d" ] && [ -f "$d/round" ] && { [ -f "$d/change" ] || [ -f "$d/base" ]; } || die "$d is not a review run directory"
  (cd "$d" && pwd -P)
}
any_dir() { # a run dir of any kind, for close: it holds a base, a change or a worker.json
  local d="$1"
  [ -n "$d" ] && [ -d "$d" ] && { [ -f "$d/base" ] || [ -f "$d/change" ] || [ -f "$d/worker.json" ]; } || die "$d is not a run directory"
  (cd "$d" && pwd -P)
}
apply_run() { # validate an apply run dir: a round counter and a worker.json, no review marker
  local d="$1"
  [ -n "$d" ] && [ -f "$d/round" ] && [ -f "$d/worker.json" ] && [ ! -f "$d/base" ] && [ ! -f "$d/change" ] || die "$d is not an apply run directory"
  (cd "$d" && pwd -P)
}
play_json() { # file round -> the file's JSON object on one line, "round" added when missing
  local c rest
  c="$(tr -d '\n' < "$1")"
  case "$c" in
    *'"round"'*) printf '%s\n' "$c" ;;
    *) rest="${c#*\{}"; rest="${rest#"${rest%%[![:space:]]*}"}"
       if [ "${rest:0:1}" = "}" ]; then printf '{"round":%s}\n' "$2"; else printf '{"round":%s,%s\n' "$2" "$rest"; fi ;;
  esac
}
status_of() { grep -o '"status": *"[a-z-]*"' "$1" | head -1 | sed 's/.*"\([a-z-]*\)"$/\1/'; }
untracked() { (cd "$root" && git ls-files --others --exclude-standard -- . ':(exclude).agk' ':(exclude).eval' ':(exclude)agk-calls.log'); }
fingerprint() { # merge base -> hash of the workspace state: each path between it and the working tree with its content
  (
    cd "$root" || exit 1
    # Like the real fingerprint, the hash does not tell committed, staged and
    # untracked apart: a commit that keeps the content keeps it.
    { git diff --no-color --name-only "$1" -- . ':(exclude).agk' ':(exclude).eval' ':(exclude)agk-calls.log'; untracked; } | sort -u | while IFS= read -r f; do
      printf 'path %s\n' "$f"
      if [ -f "$f" ]; then cat "$f"; else echo '<deleted>'; fi
    done
    # A rebasing `sync` moves the merge base, which the real fingerprint hashes.
    printf 'rebasing syncs: %s\n' "$(cat "$root/.agk/rebases" 2>/dev/null || echo 0)"
  ) | shasum | awk '{print $1}'
}
merge_base() { # base -> the commit id the scope of a diff round is built from
  git -C "$root" merge-base "$1" HEAD
}
nothing_to_review() { # base -> true when there is no diff against base and no untracked file
  [ -z "$(cd "$root" && git diff --no-color "$1" -- . ':(exclude).agk' ':(exclude).eval' ':(exclude)agk-calls.log')" ] && [ -z "$(untracked)" ]
}

cmd="${1:-}"; sub="${2:-}"
case "$cmd $sub" in
"review start")
  shift 2
  change=""; base=""; given_change=0; for_change=""; given_for=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --change) need --change $#; change="${2:-}"; given_change=1; shift 2 ;;
      --change=*) change="${1#--change=}"; given_change=1; shift ;;
      --base) need --base $#; base="${2:-}"; shift 2 ;;
      --base=*) base="${1#--base=}"; shift ;;
      --for) need --for $#; for_change="${2:-}"; given_for=1; shift 2 ;;
      --for=*) for_change="${1#--for=}"; given_for=1; shift ;;
      --reviewer) need --reviewer $#; shift 2 ;;
      --autopilot) shift ;; # the mark is cosmetic: the log of the call is all the graders need
      *) shift ;;
    esac
  done
  if [ "$given_change" = 1 ] && [ -n "$base" ]; then die "--change and --base exclude each other"; fi
  if [ "$given_for" = 1 ]; then
    [ "$given_change" = 0 ] || die "--for and --change exclude each other"
    [[ "$for_change" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "invalid change name \"$for_change\": want kebab-case, like add-dark-mode"
  fi
  if [ "$given_change" = 0 ]; then # a diff review
    base="${base:-main}"
    git -C "$root" rev-parse --verify --quiet "$base^{commit}" >/dev/null || die "merge base of \"$base\" and HEAD: unknown ref"
    nothing_to_review "$base" && die "nothing to review"
    # The case's marker plays a base that holds nothing to review either: a
    # retry at a commit id (not a branch name) finds an empty scope, too.
    if [ -f "$outcomes/retry-nothing-to-review" ] && [[ "$base" =~ ^[0-9a-f]{40}$ ]]; then die "nothing to review"; fi
    mb="$(merge_base "$base")" || die "merge base of \"$base\" and HEAD: no common ancestor"
    n=1; while [ -e "$root/.agk/reviews/$n" ]; do n=$((n + 1)); done
    dir="$root/.agk/reviews/$n"
    mkdir -p "$dir/rounds/1"
    echo 1 > "$dir/round"; echo "$base" > "$dir/base"
    if [ "$given_for" = 1 ]; then
      printf '{"worker":{"harness":"codex"},"base":"%s","for":"%s","interactive":true}\n' "$base" "$for_change" > "$dir/worker.json"
    else
      printf '{"worker":{"harness":"codex"},"base":"%s","interactive":true}\n' "$base" > "$dir/worker.json"
    fi
    fingerprint "$mb" > "$dir/rounds/1/fingerprint"
    echo "$mb" > "$dir/rounds/1/merge-base"
    note "cwd: $PWD"
    printf '{"companion":"%s","dir":"%s","started":true}\n' "$companion" "$dir"
    exit 0
  fi
  [[ "$change" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "invalid change name \"$change\""
  [ -d "$root/openspec/changes/$change" ] || die "change \"$change\" not found: no openspec/changes/$change"
  files="$(cd "$root/openspec/changes/$change" && find . -type f | sed 's#^\./##' | sort | tr '\n' ' ')"
  [ -n "$files" ] || die "nothing to review"
  note "files: $files"
  note "cwd: $PWD"
  n=1; while [ -e "$root/.agk/reviews/$n" ]; do n=$((n + 1)); done
  dir="$root/.agk/reviews/$n"
  mkdir -p "$dir/rounds/1"
  echo 1 > "$dir/round"; echo "$change" > "$dir/change"
  checksums "$change" > "$dir/rounds/1/checksums"
  printf '{"companion":"%s","dir":"%s","started":true}\n' "$companion" "$dir"
  ;;
"review wait")
  dir="$(run_dir "${3:-}")" || exit 1
  k="$(cat "$dir/round")"; rd="$dir/rounds/$k"
  if [ -f "$dir/base" ]; then kind=code; else kind=plan; fi
  if [ ! -f "$rd/review.json" ]; then
    # The case's status outcome plays the wait itself once (a closed companion, a
    # permission prompt); the next wait of the same round plays the review.
    if [ -f "$outcomes/$kind-wait-$k.json" ] && [ ! -f "$rd/wait-played" ]; then
      touch "$rd/wait-played"
      note "round $k: wait played $(status_of "$outcomes/$kind-wait-$k.json")"
      play_json "$outcomes/$kind-wait-$k.json" "$k"
      exit 0
    fi
    # The case's marker plays a file changing while the reviewer runs.
    if [ -f "$dir/base" ] && [ -f "$outcomes/edit-during-review" ]; then
      echo "// edited while the reviewer ran" >> "$root/widget.go"
    fi
    if [ -f "$outcomes/$kind-round-$k.json" ]; then cp "$outcomes/$kind-round-$k.json" "$rd/review.json"
    elif [ -f "$outcomes/round-$k.json" ]; then cp "$outcomes/round-$k.json" "$rd/review.json"
    else printf '{"verdict":"approve","summary":"The plan is consistent; nothing material to report.","findings":[],"next_steps":[]}\n' > "$rd/review.json"
    fi
  fi
  findings="$(grep -c '"title"' "$rd/review.json")"
  verdict="$(grep -o '"verdict": *"[a-z-]*"' "$rd/review.json" | sed 's/.*"\([a-z-]*\)"$/\1/')"
  echo "$verdict" > "$dir/last-verdict"
  note "round $k: $findings finding(s), verdict $verdict"
  printf '{"status":"completed","round":%s,"findings":%s,"verdict":"%s"}\n' "$k" "$findings" "$verdict"
  ;;
"review send")
  shift 2
  d=""; notefile=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --note) need --note $#; notefile="${2:-}"; shift 2 ;;
      --note=*) notefile="${1#--note=}"; shift ;;
      *) d="$1"; shift ;;
    esac
  done
  dir="$(run_dir "$d")" || exit 1
  k="$(cat "$dir/round")"
  [ -f "$dir/rounds/$k/review.json" ] || die "round $k of $dir is still running; wait for it first"
  if [ -n "$notefile" ]; then [ -r "$notefile" ] || die "read note: $notefile: no such file"; fi
  if [ -f "$dir/base" ]; then # a diff run: nothing to check beyond the scope
    base="$(cat "$dir/base")"
    nothing_to_review "$base" && die "nothing to review"
    mb="$(merge_base "$base")" || die "merge base of \"$base\" and HEAD: no common ancestor"
    next=$((k + 1)); mkdir -p "$dir/rounds/$next"
    if [ -n "$notefile" ]; then
      cp "$notefile" "$dir/rounds/$next/note.md"
      while IFS= read -r line || [ -n "$line" ]; do note "note: $line"; done < "$notefile"
    fi
    fingerprint "$mb" > "$dir/rounds/$next/fingerprint"
    echo "$mb" > "$dir/rounds/$next/merge-base"
    echo "$next" > "$dir/round"
    printf '{"companion":"%s","dir":"%s","round":%s}\n' "$companion" "$dir" "$next"
    exit 0
  fi
  change="$(cat "$dir/change")"
  [ -d "$root/openspec/changes/$change" ] || die "change \"$change\" not found: no openspec/changes/$change"
  next=$((k + 1)); mkdir -p "$dir/rounds/$next"
  if [ -n "$notefile" ]; then
    cp "$notefile" "$dir/rounds/$next/note.md"
    while IFS= read -r line || [ -n "$line" ]; do note "note: $line"; done < "$notefile"
  fi
  checksums "$change" > "$dir/rounds/$next/checksums"
  changed="$(diff "$dir/rounds/$k/checksums" "$dir/rounds/$next/checksums" | grep '^>' | awk '{print $3}' | sed "s#^openspec/changes/$change/##" | sort -u | tr '\n' ' ')"
  note "changed since round $k: ${changed:-nothing}"
  echo "$next" > "$dir/round"
  printf '{"companion":"%s","dir":"%s","round":%s}\n' "$companion" "$dir" "$next"
  ;;
"review fresh")
  dir="$(run_dir "${3:-}")" || exit 1
  [ -f "$dir/base" ] || die "$dir is a plan review: fresh covers diff reviews only"
  k="$(cat "$dir/round")"
  [ -f "$dir/rounds/$k/fingerprint" ] || die "round $k of $dir has no scope fingerprint: it was written by an older agk"
  base="$(cat "$dir/base")"
  fresh=false
  if [ -f "$dir/rounds/$k/merge-base" ]; then
    # Compare against the round's recorded merge base, as the real agk does.
    mb="$(tr -d '[:space:]' < "$dir/rounds/$k/merge-base")"
    [ -n "$mb" ] || die "round $k of $dir: merge-base is empty"
    git -C "$root" cat-file -e "$mb^{commit}" 2>/dev/null || die "round $k of $dir: recorded merge base $mb: commit $mb is not in the repository"
    scope="$mb"
    if ! git -C "$root" merge-base --is-ancestor "$mb" HEAD; then scope=""; fi
  else
    mb="$(merge_base "$base" 2>/dev/null || true)"
    scope="$base"
  fi
  if [ -n "$scope" ] && ! nothing_to_review "$scope" && [ "$(fingerprint "$scope")" = "$(cat "$dir/rounds/$k/fingerprint")" ]; then fresh=true; fi
  note "fresh: $fresh"
  printf '{"fresh":%s,"round":%s,"merge_base":"%s"}\n' "$fresh" "$k" "$mb"
  ;;
"review close")
  dir="$(any_dir "${3:-}")" || exit 1
  note "close: last verdict $(cat "$dir/last-verdict" 2>/dev/null || echo none)"
  ;;
"autopilot "*)
  # The marks of the real command need agterm; the stand-in plays the inline
  # answer and leaves its argv in the log for the graders.
  [ $# -eq 2 ] && { [ "$2" = on ] || [ "$2" = off ]; } || die "usage: agk autopilot on|off"
  printf '{"session":null,"marked":false}\n'
  ;;
"sync "*)
  shift
  change=""
  for a in "$@"; do
    case "$a" in
      --no-pull) ;;
      -*) die "unknown flag $a" ;;
      *) [ -z "$change" ] || die "usage: agk sync <change> [--no-pull]"; change="$a" ;;
    esac
  done
  [ -n "$change" ] || die "usage: agk sync <change> [--no-pull]"
  [[ "$change" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "change name \"$change\" is not kebab-case"
  base="$(git -C "$root" config --get "branch.$change.agkBase" || true)"
  [ -n "$base" ] || die "branch.$change.agkBase is not set: $change is not a worktree that \`agk apply start\` made"
  [ "$(git -C "$root" rev-parse --abbrev-ref HEAD)" = "$change" ] || die "the stand-in syncs only from the worktree of branch $change"
  dirty="$(git -C "$root" status --porcelain | sed 's/^...//' | tr '\n' ' ')"
  [ -z "$dirty" ] || die "$root has uncommitted files, commit them first: $dirty"
  [ -f "$outcomes/sync-conflict" ] && die "rebase of $change onto $base conflicts in widget.go; the rebase was aborted and the branch is as it was: resolve it by hand"
  n="$(grep -c '^agk sync ' "$log")"
  rebased=false
  if [ -f "$outcomes/sync-rebased-$n" ]; then
    rebased=true
    mkdir -p "$root/.agk"
    echo $(( $(cat "$root/.agk/rebases" 2>/dev/null || echo 0) + 1 )) > "$root/.agk/rebases"
  fi
  note "rebased: $rebased"
  printf '{"change":"%s","base":"%s","pulled":false,"rebased":%s,"head":"%s"}\n' "$change" "$base" "$rebased" "$(git -C "$root" rev-parse HEAD)"
  # The case's marker plays a file changing right after the n-th sync.
  if [ -f "$outcomes/edit-after-sync-$n" ]; then echo "// edited after the sync" >> "$root/widget.go"; fi
  ;;
"finish "*)
  shift
  [ $# -eq 1 ] && [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "usage: agk finish <change>"
  change="$1"
  base="$(git -C "$root" config --get "branch.$change.agkBase" || true)"
  [ -n "$base" ] || die "branch.$change.agkBase is not set: $change is not a worktree that \`agk apply start\` made"
  dirty="$(git -C "$root" status --porcelain | sed 's/^...//' | tr '\n' ' ')"
  [ -z "$dirty" ] || die "$root has uncommitted files, commit them first: $dirty"
  if git -C "$root" ls-tree --name-only HEAD openspec/changes/ | grep -qx "openspec/changes/$change" \
     || ! git -C "$root" ls-tree --name-only HEAD openspec/changes/archive/ | grep -qE "^openspec/changes/archive/[0-9]{4}-[0-9]{2}-[0-9]{2}-$change$"; then
    die "change $change is not archived on branch $change: archive it and commit the archive first"
  fi
  [ -f "$outcomes/finish-fail" ] && die "$base has commits that branch $change lacks: run \`agk sync $change\`, check the result again, then finish"
  note "finish: merged $change into $base"
  printf '{"change":"%s","base":"%s","head":"%s","closed":[]}\n' "$change" "$base" "$(git -C "$root" rev-parse HEAD)"
  ;;
"apply start")
  shift 2
  change=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --applier) need --applier $#; shift 2 ;;
      --applier=*|--worktree|--no-worktree|--no-pull|--autopilot) shift ;;
      -*) die "unknown flag $1" ;;
      *) [ -z "$change" ] || die "usage: agk apply start <change>"; change="$1"; shift ;;
    esac
  done
  [ -n "$change" ] || die "usage: agk apply start <change>"
  [[ "$change" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "invalid change name \"$change\": want kebab-case, like add-dark-mode"
  [ -d "$root/openspec/changes/$change" ] || die "change \"$change\" not found: no openspec/changes/$change"
  runroot="$root"; wtjson=null
  # The case's `worktree` marker plays worktree mode: commit the change on the
  # base branch (the plan commit) and run the applier in a worktree. The agent's
  # sandbox cannot create a git worktree (it may not write .git/worktrees), so the
  # scaffold makes it, hidden at .eval/worktree so the agent does not see a
  # worktree or a branch of the change before the start (scaffold-archive.sh
  # --pending-worktree, with branch.<change>.agkBase and eval.log); the stand-in
  # only brings the plan into it.
  if [ -f "$outcomes/worktree" ]; then
    base="$(git -C "$root" rev-parse --abbrev-ref HEAD)"
    wt="$root/.eval/worktree"
    [ -d "$wt" ] || die "$wt is missing: the scaffold must make the worktree"
    [ "$(git -C "$wt" config --get "branch.$change.agkBase" || true)" = "$base" ] || die "branch.$change.agkBase is not $base"
    G=(-c user.name=eval -c user.email=eval@example.invalid -c commit.gpgsign=false -c core.hooksPath=/dev/null)
    git -C "$root" "${G[@]}" add -- "openspec/changes/$change" || die "plan commit: git add failed"
    git -C "$root" "${G[@]}" commit -q -m "chore(openspec): plan $change (agk apply start)" -- "openspec/changes/$change" || die "plan commit failed"
    note "plan commit: $(git -C "$root" rev-parse --short HEAD) $(git -C "$root" log -1 --format=%s)"
    mkdir -p "$wt/openspec/changes"
    rm -rf "$wt/openspec/changes/$change"
    cp -R "$root/openspec/changes/$change" "$wt/openspec/changes/$change"
    runroot="$wt"; wtjson="\"$wt\""
  fi
  n=1; while [ -e "$runroot/.agk/applies/$n" ]; do n=$((n + 1)); done
  dir="$runroot/.agk/applies/$n"
  mkdir -p "$dir/rounds/1"
  echo 1 > "$dir/round"
  printf '{"worker":{"harness":"claude"},"change":"%s","interactive":true}\n' "$change" > "$dir/worker.json"
  printf '{"companion":"%s","dir":"%s","started":true,"worktree":%s,"pulled":false}\n' "$companion" "$dir" "$wtjson"
  ;;
"apply wait")
  shift 2
  d=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) need --timeout $#; shift 2 ;;
      --timeout=*) shift ;;
      *) d="$1"; shift ;;
    esac
  done
  dir="$(apply_run "$d")" || exit 1
  k="$(cat "$dir/round")"; rd="$dir/rounds/$k"; mkdir -p "$rd"
  if [ ! -f "$rd/report.json" ]; then
    # The case's status outcome plays the wait itself once (a permission prompt, a
    # closed companion); the next wait of the same round plays the report.
    if [ -f "$outcomes/apply-wait-$k.json" ] && [ ! -f "$rd/wait-played" ]; then
      touch "$rd/wait-played"
      note "apply round $k: $(status_of "$outcomes/apply-wait-$k.json")"
      play_json "$outcomes/apply-wait-$k.json" "$k"
      exit 0
    fi
    if [ -f "$outcomes/apply-round-$k.json" ]; then cp "$outcomes/apply-round-$k.json" "$rd/report.json"
    else
      change="$(sed -n 's/.*"change":"\([^"]*\)".*/\1/p' "$dir/worker.json")"
      total="$(grep -c '^- \[' "$root/openspec/changes/$change/tasks.md" 2>/dev/null || true)"
      total="${total:-0}"; [ "$total" -gt 0 ] || total=1
      printf '{"status":"done","progress":"%s/%s","summary":"Implemented the change; the gates pass."}\n' "$total" "$total" > "$rd/report.json"
    fi
    # A finished round leaves the code file the diff review has a scope in.
    if [ "$(status_of "$rd/report.json")" = done ]; then
      if [ ! -f "$root/widget.go" ]; then printf 'package widget\n\n// List prints the project widgets.\nfunc List() {}\n' > "$root/widget.go"
      elif [ "$k" -gt 1 ]; then echo "// applier round $k" >> "$root/widget.go"; fi
    fi
  fi
  note "apply round $k: $(status_of "$rd/report.json")"
  play_json "$rd/report.json" "$k"
  ;;
"apply send")
  shift 2
  d=""; notefile=""; stdin=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --stdin) stdin=1; shift ;;
      -*) die "unknown flag $1" ;;
      *) if [ -z "$d" ]; then d="$1"; else notefile="$1"; fi; shift ;;
    esac
  done
  dir="$(apply_run "$d")" || exit 1
  if [ "$stdin" = 1 ] && [ -n "$notefile" ]; then die "give a note file or --stdin, not both"; fi
  if [ "$stdin" = 0 ] && [ -z "$notefile" ]; then die "usage: agk apply send <dir> (<file>|--stdin)"; fi
  k="$(cat "$dir/round")"
  [ -f "$dir/rounds/$k/report.json" ] || die "round $k of $dir is still running; wait for it first"
  next=$((k + 1)); mkdir -p "$dir/rounds/$next"
  if [ "$stdin" = 1 ]; then cat > "$dir/rounds/$next/note.md"
  else [ -r "$notefile" ] || die "read note: $notefile: no such file"; cp "$notefile" "$dir/rounds/$next/note.md"
  fi
  while IFS= read -r line || [ -n "$line" ]; do note "note: $line"; done < "$dir/rounds/$next/note.md"
  echo "$next" > "$dir/round"
  printf '{"round":%s,"started":true}\n' "$next"
  ;;
"apply close")
  dir="$(any_dir "${3:-}")" || exit 1
  note "close: apply run $dir"
  ;;
"apply "*)
  echo "agk stand-in: apply is not run in evals" >&2
  ;;
"version "*|"--version "*)
  echo "agk 0.0.0-eval (stand-in)"
  ;;
*)
  ;;
esac
