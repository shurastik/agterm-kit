#!/bin/bash
# Stand-in agk for the skill evals: logs its argv to agk-calls.log in the
# workspace and plays the review outcomes of case $EVAL_AGK_CASE from
# .eval/outcomes/<case>/round-<k>.json, staged into the workspace by the
# scaffold from evals/_fixtures/outcomes/ (approve when absent). Plan reviews
# (--change) and diff reviews (--base) are both played; a diff run records the
# fingerprint of the workspace per round, which `review fresh` compares.
# `sync` and `finish` play the worktree commands on the workspace repository
# standing on the change's branch (see scaffold-archive.sh --worktree).
set -uo pipefail
# The agent's sandbox cannot run Apple's /usr/bin/git shim (xcrun wants a cache
# file outside the sandbox); the real binary behind it works.
GIT="$(command -v git || echo git)"
if ! "$GIT" --version >/dev/null 2>&1; then
  for c in /Library/Developer/CommandLineTools/usr/bin/git /Applications/Xcode.app/Contents/Developer/usr/bin/git /opt/homebrew/bin/git /usr/local/bin/git; do
    if [ -x "$c" ]; then GIT="$c"; break; fi
  done
fi
git() { "$GIT" "$@"; }
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# Run from the main checkout of a worktree case (`agk finish`), the stand-in
# still logs and plays the outcomes of the workspace that holds the case.
ws="$(git config --get eval.workspace 2>/dev/null || true)"
if [ -n "$ws" ] && [ -d "$ws" ]; then root="$ws"; fi
log="$root/agk-calls.log"
outcomes="$root/.eval/outcomes/${EVAL_AGK_CASE:-none}"
companion="EVAL-COMPANION"
echo "agk $*" >> "$log"
note() { echo "  $*" >> "$log"; }
die() { echo "agk: $*" >&2; note "error: $*"; exit 1; }
need() { [ "$2" -ge 2 ] || die "flag $1 needs a value"; } # flag, args left

checksums() { # change -> sorted "sum  path" lines of the change's files
  (cd "$root" && find "openspec/changes/$1" -type f -print0 | sort -z | xargs -0 shasum 2>/dev/null)
}
run_dir() { # validate a run dir argument: a plan run (change) or a diff run (base)
  local d="$1"
  [ -n "$d" ] && [ -f "$d/round" ] && { [ -f "$d/change" ] || [ -f "$d/base" ]; } || die "$d is not a review run directory"
  (cd "$d" && pwd -P)
}
any_dir() { # a run dir of any kind, for close: it holds a base, a change or a worker.json
  local d="$1"
  [ -n "$d" ] && [ -d "$d" ] && { [ -f "$d/base" ] || [ -f "$d/change" ] || [ -f "$d/worker.json" ]; } || die "$d is not a run directory"
  (cd "$d" && pwd -P)
}
untracked() { (cd "$root" && git ls-files --others --exclude-standard -- . ':(exclude).agk' ':(exclude).eval' ':(exclude)agk-calls.log'); }
fingerprint() { # base -> hash of the workspace state: git diff <base> plus each untracked path and content
  (
    cd "$root" || exit 1
    git diff --no-color "$1" -- . ':(exclude).agk' ':(exclude).eval' ':(exclude)agk-calls.log'
    untracked | while IFS= read -r f; do printf 'untracked %s\n' "$f"; cat "$f"; done
    # A rebasing `sync` moves the merge base, which the real fingerprint hashes.
    printf 'rebasing syncs: %s\n' "$(cat "$root/.agk/rebases" 2>/dev/null || echo 0)"
  ) | shasum | awk '{print $1}'
}
nothing_to_review() { # base -> true when there is no diff against base and no untracked file
  [ -z "$(cd "$root" && git diff --no-color "$1" -- . ':(exclude).agk' ':(exclude).eval' ':(exclude)agk-calls.log')" ] && [ -z "$(untracked)" ]
}

cmd="${1:-}"; sub="${2:-}"
case "$cmd $sub" in
"review start")
  shift 2
  change=""; base=""; given_change=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --change) need --change $#; change="${2:-}"; given_change=1; shift 2 ;;
      --change=*) change="${1#--change=}"; given_change=1; shift ;;
      --base) need --base $#; base="${2:-}"; shift 2 ;;
      --base=*) base="${1#--base=}"; shift ;;
      --reviewer) need --reviewer $#; shift 2 ;;
      *) shift ;;
    esac
  done
  if [ "$given_change" = 1 ] && [ -n "$base" ]; then die "--change and --base exclude each other"; fi
  if [ "$given_change" = 0 ]; then # a diff review
    base="${base:-main}"
    git -C "$root" rev-parse --verify --quiet "$base^{commit}" >/dev/null || die "merge base of \"$base\" and HEAD: unknown ref"
    nothing_to_review "$base" && die "nothing to review"
    n=1; while [ -e "$root/.agk/reviews/$n" ]; do n=$((n + 1)); done
    dir="$root/.agk/reviews/$n"
    mkdir -p "$dir/rounds/1"
    echo 1 > "$dir/round"; echo "$base" > "$dir/base"
    printf '{"worker":{"harness":"codex"},"base":"%s","interactive":true}\n' "$base" > "$dir/worker.json"
    fingerprint "$base" > "$dir/rounds/1/fingerprint"
    printf '{"companion":"%s","dir":"%s","started":true}\n' "$companion" "$dir"
    exit 0
  fi
  [[ "$change" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "invalid change name \"$change\""
  [ -d "$root/openspec/changes/$change" ] || die "change \"$change\" not found: no openspec/changes/$change"
  files="$(cd "$root/openspec/changes/$change" && find . -type f | sed 's#^\./##' | sort | tr '\n' ' ')"
  [ -n "$files" ] || die "nothing to review"
  note "files: $files"
  n=1; while [ -e "$root/.agk/reviews/$n" ]; do n=$((n + 1)); done
  dir="$root/.agk/reviews/$n"
  mkdir -p "$dir/rounds/1"
  echo 1 > "$dir/round"; echo "$change" > "$dir/change"
  checksums "$change" > "$dir/rounds/1/checksums"
  printf '{"companion":"%s","dir":"%s","started":true}\n' "$companion" "$dir"
  ;;
"review wait")
  dir="$(run_dir "${3:-}")" || exit 1
  k="$(cat "$dir/round")"; rd="$dir/rounds/$k"
  if [ ! -f "$rd/review.json" ]; then
    # The case's marker plays a file changing while the reviewer runs.
    if [ -f "$dir/base" ] && [ -f "$outcomes/edit-during-review" ]; then
      echo "// edited while the reviewer ran" >> "$root/widget.go"
    fi
    if [ -f "$outcomes/round-$k.json" ]; then cp "$outcomes/round-$k.json" "$rd/review.json"
    else printf '{"verdict":"approve","summary":"The plan is consistent; nothing material to report.","findings":[],"next_steps":[]}\n' > "$rd/review.json"
    fi
  fi
  findings="$(grep -c '"title"' "$rd/review.json")"
  verdict="$(grep -o '"verdict": *"[a-z-]*"' "$rd/review.json" | sed 's/.*"\([a-z-]*\)"$/\1/')"
  echo "$verdict" > "$dir/last-verdict"
  note "round $k: $findings finding(s), verdict $verdict"
  printf '{"status":"completed","round":%s,"findings":%s,"verdict":"%s"}\n' "$k" "$findings" "$verdict"
  ;;
"review send")
  shift 2
  d=""; notefile=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --note) need --note $#; notefile="${2:-}"; shift 2 ;;
      --note=*) notefile="${1#--note=}"; shift ;;
      *) d="$1"; shift ;;
    esac
  done
  dir="$(run_dir "$d")" || exit 1
  k="$(cat "$dir/round")"
  [ -f "$dir/rounds/$k/review.json" ] || die "round $k of $dir is still running; wait for it first"
  if [ -n "$notefile" ]; then [ -r "$notefile" ] || die "read note: $notefile: no such file"; fi
  if [ -f "$dir/base" ]; then # a diff run: nothing to check beyond the scope
    base="$(cat "$dir/base")"
    nothing_to_review "$base" && die "nothing to review"
    next=$((k + 1)); mkdir -p "$dir/rounds/$next"
    if [ -n "$notefile" ]; then
      cp "$notefile" "$dir/rounds/$next/note.md"
      while IFS= read -r line || [ -n "$line" ]; do note "note: $line"; done < "$notefile"
    fi
    fingerprint "$base" > "$dir/rounds/$next/fingerprint"
    echo "$next" > "$dir/round"
    printf '{"companion":"%s","dir":"%s","round":%s}\n' "$companion" "$dir" "$next"
    exit 0
  fi
  change="$(cat "$dir/change")"
  [ -d "$root/openspec/changes/$change" ] || die "change \"$change\" not found: no openspec/changes/$change"
  next=$((k + 1)); mkdir -p "$dir/rounds/$next"
  if [ -n "$notefile" ]; then
    cp "$notefile" "$dir/rounds/$next/note.md"
    while IFS= read -r line || [ -n "$line" ]; do note "note: $line"; done < "$notefile"
  fi
  checksums "$change" > "$dir/rounds/$next/checksums"
  changed="$(diff "$dir/rounds/$k/checksums" "$dir/rounds/$next/checksums" | grep '^>' | awk '{print $3}' | sed "s#^openspec/changes/$change/##" | sort -u | tr '\n' ' ')"
  note "changed since round $k: ${changed:-nothing}"
  echo "$next" > "$dir/round"
  printf '{"companion":"%s","dir":"%s","round":%s}\n' "$companion" "$dir" "$next"
  ;;
"review fresh")
  dir="$(run_dir "${3:-}")" || exit 1
  [ -f "$dir/base" ] || die "$dir is a plan review: fresh covers diff reviews only"
  k="$(cat "$dir/round")"
  [ -f "$dir/rounds/$k/fingerprint" ] || die "round $k of $dir has no scope fingerprint: it was written by an older agk"
  base="$(cat "$dir/base")"
  fresh=false
  if ! nothing_to_review "$base" && [ "$(fingerprint "$base")" = "$(cat "$dir/rounds/$k/fingerprint")" ]; then fresh=true; fi
  note "fresh: $fresh"
  printf '{"fresh":%s,"round":%s}\n' "$fresh" "$k"
  ;;
"review close")
  dir="$(any_dir "${3:-}")" || exit 1
  note "close: last verdict $(cat "$dir/last-verdict" 2>/dev/null || echo none)"
  ;;
"sync "*)
  shift
  change=""
  for a in "$@"; do
    case "$a" in
      --no-pull) ;;
      -*) die "unknown flag $a" ;;
      *) [ -z "$change" ] || die "usage: agk sync <change> [--no-pull]"; change="$a" ;;
    esac
  done
  [ -n "$change" ] || die "usage: agk sync <change> [--no-pull]"
  [[ "$change" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "change name \"$change\" is not kebab-case"
  base="$(git -C "$root" config --get "branch.$change.agkBase" || true)"
  [ -n "$base" ] || die "branch.$change.agkBase is not set: $change is not a worktree that \`agk apply start\` made"
  [ "$(git -C "$root" rev-parse --abbrev-ref HEAD)" = "$change" ] || die "the stand-in syncs only from the worktree of branch $change"
  dirty="$(git -C "$root" status --porcelain | sed 's/^...//' | tr '\n' ' ')"
  [ -z "$dirty" ] || die "$root has uncommitted files, commit them first: $dirty"
  [ -f "$outcomes/sync-conflict" ] && die "rebase of $change onto $base conflicts in widget.go; the rebase was aborted and the branch is as it was: resolve it by hand"
  n="$(grep -c '^agk sync ' "$log")"
  rebased=false
  if [ -f "$outcomes/sync-rebased-$n" ]; then
    rebased=true
    mkdir -p "$root/.agk"
    echo $(( $(cat "$root/.agk/rebases" 2>/dev/null || echo 0) + 1 )) > "$root/.agk/rebases"
  fi
  note "rebased: $rebased"
  printf '{"change":"%s","base":"%s","pulled":false,"rebased":%s,"head":"%s"}\n' "$change" "$base" "$rebased" "$(git -C "$root" rev-parse HEAD)"
  # The case's marker plays a file changing right after the n-th sync.
  if [ -f "$outcomes/edit-after-sync-$n" ]; then echo "// edited after the sync" >> "$root/widget.go"; fi
  ;;
"finish "*)
  shift
  [ $# -eq 1 ] && [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "usage: agk finish <change>"
  change="$1"
  base="$(git -C "$root" config --get "branch.$change.agkBase" || true)"
  [ -n "$base" ] || die "branch.$change.agkBase is not set: $change is not a worktree that \`agk apply start\` made"
  dirty="$(git -C "$root" status --porcelain | sed 's/^...//' | tr '\n' ' ')"
  [ -z "$dirty" ] || die "$root has uncommitted files, commit them first: $dirty"
  if git -C "$root" ls-tree --name-only HEAD openspec/changes/ | grep -qx "openspec/changes/$change" \
     || ! git -C "$root" ls-tree --name-only HEAD openspec/changes/archive/ | grep -qE "^openspec/changes/archive/[0-9]{4}-[0-9]{2}-[0-9]{2}-$change$"; then
    die "change $change is not archived on branch $change: archive it and commit the archive first"
  fi
  [ -f "$outcomes/finish-fail" ] && die "$base has commits that branch $change lacks: run \`agk sync $change\`, check the result again, then finish"
  note "finish: merged $change into $base"
  printf '{"change":"%s","base":"%s","head":"%s","closed":[]}\n' "$change" "$base" "$(git -C "$root" rev-parse HEAD)"
  ;;
"apply close")
  dir="$(any_dir "${3:-}")" || exit 1
  note "close: apply run $dir"
  ;;
"apply "*)
  echo "agk stand-in: apply is not run in evals" >&2
  ;;
"version "*|"--version "*)
  echo "agk 0.0.0-eval (stand-in)"
  ;;
*)
  ;;
esac
